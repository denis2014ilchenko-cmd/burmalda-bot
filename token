@bot.message_handler(content_types=['photo'])
def send_photos(message):
    if not message.photo:
        return bot.reply_to(message.chat.id, 'Ты не прикрепил фотку')

    file_info = bot.get_file(message.photo[-1].file_id)
    file_name = file_info.file_path.split('/')[-1]

    downloaded_file = bot.download_file(file_info.file_path)

    with open(file_name, 'wb') as f:
        f.write(downloaded_file)

    result = classify_image(file_name,"models\keras_model.h5","models\labels.txt")
    obj_name = result[0].replace("\n","").upper()
    obj_proc = result[1]

    bot.reply_to(message, f'На изображении: {obj_name}, с вероятностью: {obj_proc}%')
    os.remove(f'./{file_name}')

